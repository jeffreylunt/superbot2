#!/bin/bash
# superbot2 — single entry point: launch orchestrator, update, or run setup
set -euo pipefail
shopt -s nullglob

export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
SUPERBOT2_NAME="${SUPERBOT2_NAME:-superbot2}"
DIR="${SUPERBOT2_HOME:-$HOME/.$SUPERBOT2_NAME}"
export SUPERBOT2_HOME="$DIR"
export SUPERBOT2_NAME
CLAUDE_DIR="$DIR/.claude"
export CLAUDE_CONFIG_DIR="$CLAUDE_DIR"
TEAM_DIR="$CLAUDE_DIR/teams/$SUPERBOT2_NAME"
TEMPLATE="$DIR/templates/orchestrator-system-prompt-override.md"
RESTART_FLAG="$DIR/.restart"
LAUNCHER_PID=$$
LAUNCHER_PID_FILE="$DIR/.launcher.pid"

# Durable launcher log — survives the tmux window closing on exit. This is the
# crash-forensics trail for the orchestrator (see stability-upgrades project):
# every claude start, exit code, and pane tail at death lands here.
LAUNCHER_LOG="$DIR/logs/launcher.log"
mkdir -p "$DIR/logs" 2>/dev/null || true
llog() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] launcher[$$]: $*" >> "$LAUNCHER_LOG" 2>/dev/null || true; }

DASHBOARD_UI_PID=""

# ─── Dashboard UI ───

start_dashboard_ui() {
  local ui_dir="$REPO_DIR/dashboard-ui"
  if [[ ! -d "$ui_dir" ]]; then
    echo "Dashboard UI not found at $ui_dir — skipping"
    return
  fi

  local api_port="${SUPERBOT2_API_PORT:-3274}"
  local ui_port="${SUPERBOT2_UI_PORT:-47474}"

  # Kill any existing processes on both ports (e.g., from setup.sh or previous run)
  # so we always start fresh.
  for port in "$api_port" "$ui_port"; do
    if lsof -ti:$port -sTCP:LISTEN &>/dev/null; then
      echo "Stopping existing process on port $port..."
      lsof -ti:$port -sTCP:LISTEN | xargs kill 2>/dev/null || true
      for i in {1..20}; do
        lsof -ti:$port -sTCP:LISTEN &>/dev/null || break
        sleep 0.25
      done
    fi
  done

  # Reap ORPHANED dashboard trees that the port-kill above misses. When a prior launcher was
  # SIGKILL'd (its EXIT trap never ran), the tree it left is `npm run dev` (reparented to init,
  # PPID 1) → concurrently → npm run dev:api → node --watch server.js. The npm ROOT is the only
  # true orphan; its children keep npm as a LIVE parent, so a PPID-1 check on concurrently /
  # server.js never matched and a full duplicate tree survived (three observed 2026-07-04).
  # reap_orphaned_dashboards() reaps the orphaned in-repo npm root and its entire subtree, with
  # PPID-1 + cwd-under-REPO_DIR guards so a co-resident/sibling-checkout dashboard is untouched.
  if [[ -f "$REPO_DIR/scripts/reap-orphaned-dashboards.sh" ]]; then
    source "$REPO_DIR/scripts/reap-orphaned-dashboards.sh"
    reap_orphaned_dashboards "$REPO_DIR"
  fi
  sleep 1

  echo "Starting dashboard → http://localhost:${ui_port}"
  (cd "$ui_dir" && SUPERBOT2_API_PORT="$api_port" SUPERBOT2_UI_PORT="$ui_port" npm run dev) >>/tmp/superbot2-dashboard-ui.log 2>&1 &
  DASHBOARD_UI_PID=$!
  echo "Dashboard started (PID $DASHBOARD_UI_PID)"
}

stop_dashboard_ui() {
  if [[ -n "$DASHBOARD_UI_PID" ]]; then
    # Kill npm and all its child processes (concurrently, vite, node)
    pkill -P "$DASHBOARD_UI_PID" 2>/dev/null || true
    kill "$DASHBOARD_UI_PID" 2>/dev/null || true
    echo "Dashboard UI stopped."
    DASHBOARD_UI_PID=""
  fi
}

# ─── Subcommands ───

case "${1:-}" in
  update)
    exec bash "$REPO_DIR/scripts/update.sh"
    ;;

  setup)
    exec bash "$REPO_DIR/scripts/setup.sh"
    ;;

  server)
    exec bash "$REPO_DIR/scripts/restart-dashboard.sh"
    ;;

  sync-app)
    # Sync dev repo to ~/.superbot2-app/ so the user can test the installed experience
    APP_DIR="${SUPERBOT2_APP_DIR:-$HOME/.${SUPERBOT2_NAME}-app}"
    echo ""
    echo "Syncing dev repo → $APP_DIR"
    echo ""

    mkdir -p "$APP_DIR"

    rsync -av --delete \
      --exclude '.git' \
      --exclude 'node_modules' \
      --exclude '.env' \
      --exclude '.env.*' \
      "$REPO_DIR/" "$APP_DIR/"

    echo ""
    echo "Installing dependencies..."
    if [[ -f "$APP_DIR/dashboard/package.json" ]]; then
      (cd "$APP_DIR/dashboard" && npm install --silent) && echo "  dashboard/ deps installed" \
        || echo "  WARNING: dashboard/ npm install failed"
    fi
    if [[ -f "$APP_DIR/dashboard-ui/package.json" ]]; then
      (cd "$APP_DIR/dashboard-ui" && npm install --silent) && echo "  dashboard-ui/ deps installed" \
        || echo "  WARNING: dashboard-ui/ npm install failed"
    fi

    echo ""
    echo "Building dashboard UI..."
    if (cd "$APP_DIR/dashboard-ui" && npm run build); then
      echo "  Build succeeded"
    else
      echo "  WARNING: Build failed — using pre-built dist/ from dev repo"
    fi

    # Sync git HEAD in app dir so the update checker shows "up to date"
    # (rsync doesn't touch .git, so HEAD would be stale without this)
    if [[ -d "$APP_DIR/.git" ]]; then
      git -C "$APP_DIR" fetch origin --quiet 2>/dev/null || true
      git -C "$APP_DIR" reset --mixed origin/main --quiet 2>/dev/null || true
      echo "  Git state synced"
    fi

    # Update alias to point to app dir (only — do NOT run setup.sh, it would
    # back up and overwrite the live ~/.superbot2 runtime data)
    echo ""
    echo "Updating shell alias..."
    SHELL_PROFILE=""
    if [[ "$SHELL" == *zsh* ]]; then SHELL_PROFILE="$HOME/.zshrc"
    elif [[ "$SHELL" == *bash* ]]; then SHELL_PROFILE="$HOME/.bashrc"; fi
    if [[ -n "$SHELL_PROFILE" ]]; then
      NEW_ALIAS="alias $SUPERBOT2_NAME=\"SUPERBOT2_NAME=$SUPERBOT2_NAME SUPERBOT2_HOME=$DIR $APP_DIR/superbot2\""
      if grep -q "alias $SUPERBOT2_NAME=" "$SHELL_PROFILE" 2>/dev/null; then
        sed -i '' "s|alias $SUPERBOT2_NAME=.*|$NEW_ALIAS|" "$SHELL_PROFILE"
        echo "  Updated alias → $APP_DIR/superbot2"
      else
        echo "" >> "$SHELL_PROFILE"
        echo "# $SUPERBOT2_NAME" >> "$SHELL_PROFILE"
        echo "$NEW_ALIAS" >> "$SHELL_PROFILE"
        echo "  Added alias → $APP_DIR/superbot2"
      fi
    fi

    echo ""
    echo "  ╔═══════════════════════════════════════════╗"
    echo "  ║          sync-app complete!               ║"
    echo "  ╚═══════════════════════════════════════════╝"
    echo ""
    echo "  App dir:  $APP_DIR"
    echo "  Data dir: $DIR"
    echo ""
    echo "  To test as an end user:"
    echo "    1. Restart your terminal (alias now points to $APP_DIR)"
    echo "    2. Run: $SUPERBOT2_NAME"
    echo ""
    echo "  To go back to dev mode:"
    echo "    Run: bash $REPO_DIR/scripts/setup.sh"
    echo "    Then restart your terminal."
    echo ""
    exit 0
    ;;

  help|--help|-h)
    echo "Usage: superbot2 [command]"
    echo ""
    echo "Commands:"
    echo "  (none)            Start the superbot2 orchestrator"
    echo "  server            Restart the dashboard server"
    echo "  update            Pull latest code and redeploy (preserves user data)"
    echo "  setup             Re-run initial setup"
    echo "  sync-app          Sync dev repo to ~/.superbot2-app/ for end-user testing"
    echo "  help              Show this help"
    echo ""
    exit 0
    ;;
esac

# ─── Single-instance guard (LAUNCH PATH ONLY) ───
# This must stay BELOW the subcommand block: it used to run before it, so ANY
# invocation — including `superbot2 help` — killed the live orchestrator.
#
# Forensics: THIS is one of only two code paths that deliberately kill the
# orchestrator claude process (the other is the .restart watchdog subshell).
# Record who invoked us so an automated caller murdering a healthy orchestrator
# can be identified from the log alone.
if [[ -f "$LAUNCHER_PID_FILE" ]]; then
  OLD_PID=$(cat "$LAUNCHER_PID_FILE" 2>/dev/null || echo "")
  if [[ -n "$OLD_PID" ]] && [[ "$OLD_PID" != "$$" ]] && kill -0 "$OLD_PID" 2>/dev/null; then
    # A live claude CHILD of the old launcher means the orchestrator is ALIVE and
    # this invocation is almost certainly a mistake (watchdog false-DOWN relaunch,
    # stray automation) — refuse to replace it unless explicitly forced. ps+awk on
    # pid/ppid/comm/ucomm (NOT pgrep, NOT an argv match): pgrep -f intermittently
    # misses the orchestrator's ~300KB argv AND is blind to ancestors of the calling
    # shell. comm (argv[0]) = "claude"; ucomm (p_comm, always readable) = the
    # versioned binary basename (e.g. "2.1.201") — accept either.
    CLAUDE_BIN_NAME=$(basename "$(readlink "$HOME/.local/bin/claude" 2>/dev/null || true)" 2>/dev/null || true)
    OLD_CLAUDE_PIDS=$(ps -axo pid=,ppid=,comm=,ucomm= 2>/dev/null | awk -v p="$OLD_PID" -v b="$CLAUDE_BIN_NAME" '$2 == p && ($3 == "claude" || (b != "" && $4 == b)) { printf "%s ", $1 }' || true)
    OLD_CLAUDE_PIDS="${OLD_CLAUDE_PIDS% }"
    if [[ -n "$OLD_CLAUDE_PIDS" && "${SUPERBOT2_TAKEOVER:-}" != "1" ]]; then
      echo "A superbot2 orchestrator is already RUNNING (launcher PID $OLD_PID, claude PID(s) $OLD_CLAUDE_PIDS)."
      echo "Refusing to replace it."
      echo "  To restart it gracefully (session preserved): touch $RESTART_FLAG"
      echo "  To force a takeover (kills the running one):  SUPERBOT2_TAKEOVER=1 superbot2"
      llog "single-instance guard REFUSED takeover: old launcher pid=$OLD_PID has live claude child(ren) $OLD_CLAUDE_PIDS (invoker: args='${*:-}' ppid=$PPID parent='$(ps -o command= -p $PPID 2>/dev/null | head -c 120 || true)')"
      exit 1
    fi
    echo "Found existing superbot2 launcher (PID $OLD_PID). Stopping it..."
    llog "single-instance guard KILLING old launcher pid=$OLD_PID claude_children='$OLD_CLAUDE_PIDS' takeover=${SUPERBOT2_TAKEOVER:-0} (invoker: args='${*:-}' ppid=$PPID parent='$(ps -o command= -p $PPID 2>/dev/null | head -c 120 || true)')"
    # Kill the old launcher and all its child processes (claude, dashboard, watchdog)
    pkill -TERM -P "$OLD_PID" 2>/dev/null || true
    kill -TERM "$OLD_PID" 2>/dev/null || true
    sleep 2
    # Force kill if still alive
    kill -9 "$OLD_PID" 2>/dev/null || true
    echo "Old launcher stopped."
  fi
fi

echo "$LAUNCHER_PID" > "$LAUNCHER_PID_FILE"
trap 'stop_dashboard_ui; rm -f "$LAUNCHER_PID_FILE"' EXIT

# ─── Guard: run setup if not initialized ───

if [[ ! -d "$DIR" ]]; then
  echo "Superbot2 not set up yet. Running setup..."
  bash "$REPO_DIR/scripts/setup.sh"
fi

# ─── Assemble system prompt ───

assemble_prompt() {
  local prompt
  prompt=$(cat "$TEMPLATE")

  # Substitute identity
  if [[ -f "$DIR/IDENTITY.md" ]]; then
    local identity
    identity=$(cat "$DIR/IDENTITY.md")
    prompt="${prompt//\{\{IDENTITY\}\}/$identity}"
  else
    prompt="${prompt//\{\{IDENTITY\}\}/No identity configured yet.}"
  fi

  # Substitute user profile
  if [[ -f "$DIR/USER.md" ]]; then
    local user
    user=$(cat "$DIR/USER.md")
    prompt="${prompt//\{\{USER\}\}/$user}"
  else
    prompt="${prompt//\{\{USER\}\}/No user profile configured yet.}"
  fi

  # Substitute memory
  if [[ -f "$DIR/MEMORY.md" ]]; then
    local memory
    memory=$(cat "$DIR/MEMORY.md")
    prompt="${prompt//\{\{MEMORY\}\}/$memory}"
  else
    prompt="${prompt//\{\{MEMORY\}\}/No memory yet.}"
  fi

  # --- Pre-load context ---

  # Knowledge files
  local kfiles=("$DIR"/knowledge/*)
  if [[ ${#kfiles[@]} -gt 0 ]]; then
    prompt+=$'\n\n## Knowledge\n'
    for f in "${kfiles[@]}"; do
      [[ -f "$f" ]] || continue
      prompt+=$'\n### '"$(basename "$f")"$'\n\n'
      prompt+=$(cat "$f")
    done
  fi

  # Space configs
  local sfiles=("$DIR"/spaces/*/space.json)
  if [[ ${#sfiles[@]} -gt 0 ]]; then
    prompt+=$'\n\n## Spaces\n'
    for f in "${sfiles[@]}"; do
      [[ -f "$f" ]] || continue
      local slug
      slug=$(basename "$(dirname "$f")")
      prompt+=$'\n### '"$slug"$'\n\n```json\n'
      prompt+=$(cat "$f")
      prompt+=$'\n```\n'
    done
  fi

  # Skill orchestrator instructions — scan attached skills for orchestrator.heartbeat
  local skill_instructions
  local _orch_script
  _orch_script=$(mktemp)
  cat > "$_orch_script" << 'ORCHEOF'
const fs = require('fs'), path = require('path');
const dir = process.argv[1], repoDir = process.argv[2];
const spacesDir = path.join(dir, 'spaces');
const pluginCache = path.join(dir, '.claude/plugins/cache');
const results = [];
if (!fs.existsSync(spacesDir)) process.exit(0);
for (const slug of fs.readdirSync(spacesDir)) {
  const spaceFile = path.join(spacesDir, slug, 'space.json');
  if (!fs.existsSync(spaceFile)) continue;
  try {
    const space = JSON.parse(fs.readFileSync(spaceFile, 'utf8'));
    for (const skillId of (space.skills || [])) {
      let manifest = null;
      const repoPath = path.join(repoDir, 'skills', skillId, 'superbot.json');
      if (fs.existsSync(repoPath)) {
        manifest = JSON.parse(fs.readFileSync(repoPath, 'utf8'));
      } else {
        const match = skillId.match(/^(.+?)__(.+)$/);
        if (match) {
          const [, pluginName, skillName] = match;
          if (fs.existsSync(pluginCache)) {
            for (const mp of fs.readdirSync(pluginCache)) {
              const pDir = path.join(pluginCache, mp, pluginName);
              if (!fs.existsSync(pDir)) continue;
              for (const ver of fs.readdirSync(pDir)) {
                const sp = path.join(pDir, ver, 'skills', skillName, 'superbot.json');
                if (fs.existsSync(sp)) { manifest = JSON.parse(fs.readFileSync(sp, 'utf8')); break; }
              }
              if (manifest) break;
            }
          }
        }
      }
      if (manifest && manifest.orchestrator && manifest.orchestrator.heartbeat) {
        const prio = manifest.orchestrator.priority || 'medium';
        results.push({ skill: manifest.name || skillId, space: space.name || slug, priority: prio, instruction: manifest.orchestrator.heartbeat });
      }
    }
  } catch {}
}
if (results.length > 0) {
  const order = { high: 0, medium: 1, low: 2 };
  results.sort((a, b) => (order[a.priority] || 1) - (order[b.priority] || 1));
  let out = '';
  for (const r of results) {
    out += '\n- **' + r.skill + '** (' + r.space + ', ' + r.priority + '): ' + r.instruction;
  }
  console.log(out);
}
ORCHEOF
  skill_instructions=$(node "$_orch_script" "$DIR" "$REPO_DIR" 2>/dev/null)
  rm -f "$_orch_script"
  if [[ -n "$skill_instructions" ]]; then
    prompt+=$'\n\n## Skill Orchestrator Instructions\n\nThese skills have declared heartbeat instructions. During each heartbeat cycle, incorporate these into your work:\n'
    prompt+="$skill_instructions"
  fi

  # Pending escalations
  local pfiles=("$DIR"/escalations/pending/*.json)
  if [[ ${#pfiles[@]} -gt 0 ]]; then
    prompt+=$'\n\n## Pending Escalations\n'
    for f in "${pfiles[@]}"; do
      [[ -f "$f" ]] || continue
      prompt+=$'\n### '"$(basename "$f")"$'\n\n```json\n'
      prompt+=$(cat "$f")
      prompt+=$'\n```\n'
    done
  fi

  # Draft escalations
  local dfiles=("$DIR"/escalations/draft/*.json)
  if [[ ${#dfiles[@]} -gt 0 ]]; then
    prompt+=$'\n\n## Draft Escalations\n'
    for f in "${dfiles[@]}"; do
      [[ -f "$f" ]] || continue
      prompt+=$'\n### '"$(basename "$f")"$'\n\n```json\n'
      prompt+=$(cat "$f")
      prompt+=$'\n```\n'
    done
  fi

  # Substitute team name (last — catches placeholders in all appended content)
  prompt="${prompt//\{\{TEAM_NAME\}\}/$SUPERBOT2_NAME}"

  echo "$prompt"
}

# ─── Session ID ───

SESSION_FILE="$DIR/.orchestrator-session"
SESSION_ID=$(uuidgen | tr '[:upper:]' '[:lower:]')
echo "$SESSION_ID" > "$SESSION_FILE"
echo "Generated session ID: $SESSION_ID"

# Remove stale team config so TeamCreate can create it fresh
mkdir -p "$TEAM_DIR/inboxes"
rm -f "$TEAM_DIR/config.json"

# ─── Main loop with restart support ───

rm -f "$RESTART_FLAG"
IS_RESTART=false

# Ensure heartbeat is running
if ! launchctl list com.superbot2.heartbeat &>/dev/null; then
  echo "Installing heartbeat..."
  bash "$REPO_DIR/scripts/install-heartbeat.sh"
fi

# Ensure scheduler is running
if ! launchctl list com.superbot2.scheduler &>/dev/null; then
  echo "Installing scheduler..."
  bash "$REPO_DIR/scripts/install-scheduler.sh"
fi

start_dashboard_ui

echo "Starting superbot2 orchestrator..."

while true; do
  # Assemble fresh context each iteration
  PROMPT=$(assemble_prompt)

  # Start watchdog: monitors for restart flag, kills claude when found.
  # Side duty: every ~5 min, rotate the pane-mirror log if it grew huge (a long
  # TUI session redraws constantly). Close-pipe → truncate → reopen, so the
  # writer never holds a deleted inode. Failures here never affect the kill path.
  (
    _tick=0
    while true; do
      sleep 1
      if [[ -f "$RESTART_FLAG" ]]; then
        # Kill only the claude child process (NOT the launcher bash — that must stay alive to restart)
        pkill -TERM -P "$LAUNCHER_PID" 2>/dev/null || true
        # Wait 3 seconds then SIGKILL if still alive
        sleep 3
        pkill -KILL -P "$LAUNCHER_PID" 2>/dev/null || true
        exit 0
      fi
      _tick=$((_tick + 1))
      if (( _tick % 300 == 0 )) && [[ -n "${TMUX_PANE:-}" ]]; then
        _pane_log="$DIR/logs/orchestrator-pane.log"
        if [[ -f "$_pane_log" ]] && (( $(stat -f%z "$_pane_log" 2>/dev/null || echo 0) > 50000000 )); then
          tmux pipe-pane -t "$TMUX_PANE" 2>/dev/null || true
          { tail -c 5000000 "$_pane_log" > "$_pane_log.tmp" 2>/dev/null && mv "$_pane_log.tmp" "$_pane_log"; } || true
          tmux pipe-pane -o -t "$TMUX_PANE" "exec /bin/sh -c 'cat >> \"$_pane_log\"'" 2>/dev/null || true
        fi
      fi
    done
  ) &
  WATCHDOG_PID=$!

  # Build claude args
  # --model: the orchestrator ALWAYS runs on Opus (Jeff, 2026-07-05). It must never
  # inherit a Fable/other default from ~/.claude/settings.json — because cwd=$HOME, that
  # project-level settings file overrides CLAUDE_CONFIG_DIR and silently pinned Fable 5,
  # which hit its usage limit and wedged the orchestrator (couldn't take a turn; Telegram
  # backed up). An explicit flag wins over settings and survives restarts. Workers pick
  # their own model per task via spawn-worker.sh --model (default opus).
  CLAUDE_ARGS=(
    --system-prompt "$PROMPT"
    --session-id "$SESSION_ID"
    --model "${SUPERBOT2_ORCH_MODEL:-opus}"
    --dangerously-skip-permissions
  )

  if [[ "$IS_RESTART" == true ]]; then
    CLAUDE_ARGS+=(--resume "$SESSION_ID")
    INITIAL_MSG="Session restarted with fresh context. Begin your cycle."
  else
    INITIAL_MSG="Begin your cycle."
  fi

  # Purge self-addressed idle notifications from team-lead inbox
  # (Claude Code sends idle_notification to the team lead when any teammate's turn
  # ends — including the team lead itself, causing an infinite wake loop)
  INBOX="$TEAM_DIR/inboxes/team-lead.json"
  if [[ -f "$INBOX" ]] && command -v jq &>/dev/null; then
    jq '[.[] | select(.from != "team-lead" or ((.text // "") | test("idle_notification") | not))]' \
      "$INBOX" > "$INBOX.tmp" && mv "$INBOX.tmp" "$INBOX"
  fi

  # Trigger heartbeat to seed inbox
  bash "$REPO_DIR/scripts/heartbeat-cron.sh" &

  # ── Crash forensics: mirror everything this pane displays to a durable log.
  # claude needs a real TTY (it's an interactive TUI), so we must NOT redirect
  # its stdio. tmux pipe-pane taps the pane's output stream server-side instead:
  # the TTY stays pristine and we still get every byte claude prints — including
  # any dying error message that the closing window would otherwise swallow.
  PANE_LOG="$DIR/logs/orchestrator-pane.log"
  if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
    # Rotate first (close the pipe so the writer doesn't keep the old inode).
    if [[ -f "$PANE_LOG" ]] && (( $(stat -f%z "$PANE_LOG" 2>/dev/null || echo 0) > 20000000 )); then
      tmux pipe-pane -t "$TMUX_PANE" 2>/dev/null || true   # close any open pipe
      tail -c 2000000 "$PANE_LOG" > "$PANE_LOG.tmp" 2>/dev/null && mv "$PANE_LOG.tmp" "$PANE_LOG" || true
    fi
    # -o: only open if no pipe is already open (idempotent across loop iterations)
    tmux pipe-pane -o -t "$TMUX_PANE" "exec /bin/sh -c 'cat >> \"$PANE_LOG\"'" 2>/dev/null \
      || llog "WARN: tmux pipe-pane failed — pane output will not be mirrored"
  else
    llog "not inside tmux — pane mirroring and exit-screen capture unavailable"
  fi

  # Run claude in the background so we can attach a caffeinate companion to its
  # PID. claude stays a DIRECT child of the launcher so the restart watchdog's
  # `pkill -P "$LAUNCHER_PID"` still terminates it correctly.
  # || true: bypass set -e so bash continues to the restart check even when claude
  # exits with a non-zero code (e.g. 143 from SIGTERM). Without this, set -e would
  # kill the bash script before the restart loop runs.
  claude "${CLAUDE_ARGS[@]}" "$INITIAL_MSG" &
  CLAUDE_PID=$!
  llog "claude STARTED pid=$CLAUDE_PID session=$SESSION_ID resume=$IS_RESTART pane=${TMUX_PANE:-none} binary=$(readlink "$(command -v claude 2>/dev/null)" 2>/dev/null || command -v claude 2>/dev/null || echo unknown)"

  # Register `dashboard-user` in the active team as soon as the harness creates its
  # config.json. The harness seeds each new session team with only team-lead as a member,
  # so the orchestrator's SendMessage({to:'dashboard-user'}) reply path would otherwise be
  # rejected until the watchdog's next poll. This short background poll makes the FIRST
  # reply path ready within ~1s of the team appearing. Idempotent; the telegram watchdog is
  # the steady-state backstop (see scripts/ensure-dashboard-user.mjs). Best-effort: never
  # blocks claude, exits when claude exits.
  (
    for _ in $(seq 1 60); do
      kill -0 "$CLAUDE_PID" 2>/dev/null || break
      if node "$REPO_DIR/scripts/ensure-dashboard-user.mjs" 2>/dev/null; then
        # Stop once dashboard-user is present in the active team's config.
        if node -e '
          const fs=require("fs"),path=require("path");
          const teamsDir=path.join(process.env.SUPERBOT2_HOME,".claude","teams");
          let teams=[]; try{teams=fs.readdirSync(teamsDir)}catch{process.exit(1)}
          for(const t of teams){
            try{
              const c=JSON.parse(fs.readFileSync(path.join(teamsDir,t,"config.json"),"utf8"));
              if(Array.isArray(c.members)&&c.members.some(m=>m&&m.name==="dashboard-user"))process.exit(0);
            }catch{}
          }
          process.exit(1);
        ' 2>/dev/null; then
          break
        fi
      fi
      sleep 1
    done
  ) &
  ENSURE_DU_PID=$!

  # Anti-App-Nap / anti-idle-sleep companion: -d display, -i system idle,
  # -m disk idle, -s on AC, -u declares user activity. -w exits when claude
  # exits. Holding these assertions keeps the orchestrator from being throttled
  # when Terminal.app is unfocused/occluded (App Nap) or the machine idles.
  caffeinate -dimsu -w "$CLAUDE_PID" &
  CAFFEINATE_PID=$!
  CLAUDE_EXIT=0
  wait "$CLAUDE_PID" || CLAUDE_EXIT=$?

  # ── Crash forensics: persist HOW claude died before anything else can fail.
  # Exit codes >128 mean death by signal (128+N): 143=SIGTERM (watchdog subshell,
  # single-instance guard, or wedge kill), 137=SIGKILL, 129=SIGHUP (tmux window
  # closed under it). A plain code means claude exited by itself — the case the
  # crash-loop investigation needs the pane tail for.
  EXIT_DETAIL="code=$CLAUDE_EXIT"
  if (( CLAUDE_EXIT > 128 )); then
    SIG_NAME=$(kill -l $((CLAUDE_EXIT - 128)) 2>/dev/null || echo "?")
    EXIT_DETAIL="code=$CLAUDE_EXIT (signal SIG${SIG_NAME})"
  fi
  RESTART_FLAG_STATE="absent"
  [[ -f "$RESTART_FLAG" ]] && RESTART_FLAG_STATE="present"
  llog "claude EXITED $EXIT_DETAIL session=$SESSION_ID restart_flag=$RESTART_FLAG_STATE"
  if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
    {
      echo "----- pane tail at claude exit ($(date -u +%Y-%m-%dT%H:%M:%SZ) session=$SESSION_ID $EXIT_DETAIL) -----"
      tmux capture-pane -t "$TMUX_PANE" -p -S -80 2>/dev/null | sed -e 's/[[:space:]]*$//' | awk 'NF' | tail -40 || true
      echo "----- end pane tail -----"
    } >> "$LAUNCHER_LOG" 2>/dev/null || true
  fi

  # Claude exited — clean up watchdog, caffeinate companion, and the registration poll.
  # Every step is || true-guarded: under set -e a failing kill/wait (e.g. wait
  # reporting the SIGTERM we just delivered) would abort the launcher HERE and
  # silently skip the restart check below, turning a graceful .restart into a
  # full crash (new session id, lost context).
  kill $WATCHDOG_PID 2>/dev/null || true
  wait $WATCHDOG_PID 2>/dev/null || true
  kill $CAFFEINATE_PID 2>/dev/null || true
  wait $CAFFEINATE_PID 2>/dev/null || true
  kill $ENSURE_DU_PID 2>/dev/null || true
  wait $ENSURE_DU_PID 2>/dev/null || true

  # Check if this was a restart request
  if [[ -f "$RESTART_FLAG" ]]; then
    rm -f "$RESTART_FLAG"
    IS_RESTART=true

    llog "restart flag present — relaunching claude with --resume $SESSION_ID"
    echo ""
    echo "Superbot2 restarting — resuming session $SESSION_ID"
    echo ""
    continue
  fi

  # Normal exit
  llog "no restart flag — launcher exiting (tmux window will close)"
  break
done

echo "Superbot2 orchestrator stopped."
